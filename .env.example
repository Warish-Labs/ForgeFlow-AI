# ForgeFlow AI — Complete Environment Configuration Reference

# ── Database ─────────────────────────────────────────────────────────────
# Local Postgres URL (note: @ in password must be URL-encoded as %40)
DATABASE_URL="postgresql://postgres:Warish%40786@localhost:5433/forgeflow"
DIRECT_URL="postgresql://postgres:Warish%40786@localhost:5433/forgeflow"

# ── Authentication (Clerk) ────────────────────────────────────────────────
# Get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"

# Clerk Route Overrides
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ── App Base URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI Model & Search Providers ─────────────────────────────────────────
LLM_PROVIDER="groq" # "groq" | "gemini"
GROQ_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
TAVILY_API_KEY="" # Get from https://tavily.com for live web search capabilities

# ── Cache & Rate Limiting (Upstash Redis) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Super Admin & Quota Governance ────────────────────────────────────────
# Super Admin email whitelist (checked server-side in lib/auth/guard.ts)
ADMIN_EMAIL_1="admin@warishlabs.in"
ADMIN_EMAIL_2="warish@warishlabs.in"
ADMIN_USER_IDS="warishdeveloper@gmail.com,warishprojects@gmail.com" # optional comma-separated IDs or emails

# Plan Quotas
FREE_MAX_PROJECTS=1
FREE_AI_TOKEN_LIMIT=50000
FREE_AI_REQUEST_LIMIT=50

# ── Email Service (Resend Integration) ───────────────────────────────────
# Get key from https://resend.com
RESEND_API_KEY="re_placeholder_key"
RESEND_FROM_EMAIL="ForgeFlow AI <onboarding@resend.dev>"

# ── In-App Contact Form & Notification ────────────────────────────────────
CONTACT_FORM_TO_EMAIL="warishdeveloper@gmail.com"
CONTACT_FORM_FROM_EMAIL="ForgeFlow AI Support <onboarding@resend.dev>"

# ── Cloudflare Turnstile Bot Protection ──────────────────────────────────
# Sitekey (public): use 0x4AAAAAAAAAAAAAAAAAAAAAAAAA for local testing (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAAAAAAAAAAAAAAAAAAAA"
# Secret key (server-only): use 0x4AAAAAAAAAAAAAAAAAAAAAAAAA for local testing (always passes)
TURNSTILE_SECRET_KEY="0x4AAAAAAAAAAAAAAAAAAAAAAAAA"

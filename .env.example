# ---- Database (Prisma + Postgres) ----
# Local dev: `supabase start` (Supabase CLI) prints a local connection string — use that.
# Or run Postgres via docker-compose.yml if Supabase CLI/Docker-for-Supabase isn't available:
#   docker compose up -d
#   then use the URL below as-is.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forgeflow  # pooled connection string, used by the running app
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/forgeflow    # direct (non-pooled) connection string, used by `prisma migrate`

# For Supabase hosted (Vercel deploy):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ---- Auth (Clerk — https://dashboard.clerk.com) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# CLERK_WEBHOOK_SECRET=              # only needed if you later add a local user cache — not MVP

# ---- LLM providers ----
LLM_PROVIDER=groq                    # groq | gemini — one env var swaps the whole app, see lib/ai/provider.ts
GROQ_API_KEY=                        # console.groq.com — free, no card
GROQ_MODEL=llama-3.3-70b-versatile   # verify current model id/limits at console.groq.com before relying on this
GOOGLE_GENERATIVE_AI_API_KEY=        # aistudio.google.com — free, no card, Flash-class models only
GEMINI_MODEL=gemini-2.5-flash        # verify current GA model id at ai.google.dev/gemini-api/docs/models
EMBEDDING_PROVIDER=local             # local (transformers.js, zero cost) | gemini — Phase 4 only, ignore until then
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---- Rate limiting (Upstash Redis — https://upstash.com, free tier) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_DAILY_REQUEST_LIMIT=50            # per-project daily cap, protects your free LLM quota

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

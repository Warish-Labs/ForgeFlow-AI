# ForgeFlow AI — Complete Environment Configuration Reference

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:Warish%40786@localhost:5433/forgeflow"
DIRECT_URL="postgresql://postgres:Warish%40786@localhost:5433/forgeflow"

# ── Authentication (Clerk) ────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ── App Base URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI Model & Search Providers ─────────────────────────────────────────
LLM_PROVIDER="groq" # "groq" | "gemini"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
TAVILY_API_KEY="" # Get from https://tavily.com for live web search capabilities

# ── Cache & Rate Limiting (Upstash Redis) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Super Admin & Quota Governance ────────────────────────────────────────
ADMIN_EMAIL_1="admin@warishlabs.in"
ADMIN_EMAIL_2="warish@warishlabs.in"
ADMIN_USER_IDS="warishlabs@gmail.com,warishprojects@gmail.com"

FREE_MAX_PROJECTS=1
FREE_AI_TOKEN_LIMIT=50000
FREE_AI_REQUEST_LIMIT=50

# ── Email Service (Resend Integration) ───────────────────────────────────
RESEND_API_KEY="re_placeholder_key"
RESEND_FROM_EMAIL="ForgeFlow AI <onboarding@resend.dev>"

# ── In-App Contact Form & Notification ────────────────────────────────────
CONTACT_FORM_TO_EMAIL="warishprojects@gmail.com"
CONTACT_FORM_FROM_EMAIL="ForgeFlow AI Support <onboarding@resend.dev>"

# ── Parent Engineering Organization Info ──────────────────────────────────
NEXT_PUBLIC_PARENT_SITE_URL="https://warishlabs.in"

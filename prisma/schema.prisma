// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Project Lifecycle ──────────────────────────────────────────────────────

model Project {
  id                String        @id @default(cuid())
  ownerId           String
  name              String
  ideaText          String
  problemStatement  String?
  status            ProjectStatus @default(PLANNING)
  // Zod-validated on write — never allow unvalidated structured output to touch the DB
  requirements      Json?
  techStack         Json?
  architecture      Json?
  architectureText  String?
  assumptions       Json?
  openQuestions     Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  features     Feature[]
  decisions    Decision[]
  roadmapItems RoadmapItem[]
  chatSessions ChatSession[]
  documents    Document[]
  aiUsage      AiUsageLog[]

  @@index([ownerId])
  @@index([ownerId, status])
}

enum ProjectStatus {
  PLANNING
  ARCHITECTURE
  ROADMAP_READY
  EXPORTED
}

// ─── Features ───────────────────────────────────────────────────────────────

model Feature {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  phase       FeaturePhase @default(MVP)
  status      String       @default("planned")

  @@index([projectId])
}

enum FeaturePhase {
  MVP
  PHASE_2
  PHASE_3
}

// ─── Decision Log ────────────────────────────────────────────────────────────

model Decision {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decision      String
  reasoning     String
  alternative   String?
  affectedAreas String[]
  createdAt     DateTime @default(now())

  @@index([projectId])
}

// ─── Roadmap ─────────────────────────────────────────────────────────────────

model RoadmapItem {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  phase     FeaturePhase @default(MVP)
  status    String       @default("todo")
  dependsOn String[]
  order     Int          @default(0)

  @@index([projectId])
}

// ─── Chat ────────────────────────────────────────────────────────────────────

model ChatSession {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  @@index([projectId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant" | "system"
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId   String?  @default("")
  type      String   // "PRD" | "REQUIREMENTS" | "FEATURES" | "STACK" | "ARCHITECTURE" | "ADRS" | "DATABASE" | "SECURITY" | "ROADMAP" | "BLUEPRINT"
  title     String
  content   String
  version   Int      @default(1)
  status    String   @default("Generated") // "Draft" | "Generated" | "Edited"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([ownerId])
}

// ─── Observability ───────────────────────────────────────────────────────────

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String   @default("system")
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operation        String   // "chat" | "analyze" | "architecture" | "roadmap" | "document"
  provider         String   // "groq" | "gemini" | "tavily"
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  durationMs       Int      @default(0)
  status           String   // "success" | "error" | "quota_exceeded"
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([projectId])
}

// ─── System & Admin Audit Log ───────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  action    String   // "PROJECT_CREATED" | "PROJECT_DELETED" | "AI_QUOTA_TRIGGERED" | "ADMIN_ACCESS" | "DOCUMENT_GENERATED" | "DOCUMENT_EDITED"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Watchlist & Newsletter Subscribers ─────────────────────────────────────

model Watchlist {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing_modal")
  status    String   @default("active") // "active" | "unsubscribed"
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ─── Contact Messages (In-App Contact Form) ───────────────────────────────────

model ContactMessage {
  id        String         @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean        @default(false)
  isDeleted Boolean        @default(false)
  replies   ContactReply[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([isRead])
  @@index([isDeleted])
  @@index([createdAt])
}

model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  adminUserId      String
  adminEmail       String
  body             String
  sentAt           DateTime       @default(now())

  @@index([contactMessageId])
}

// ─── AI Model Pricing (versioned, for cost estimation) ───────────────────────

model ModelPricing {
  id                     String   @id @default(cuid())
  model                  String
  provider               String
  inputPricePer1mTokens  Float    @default(0)
  outputPricePer1mTokens Float    @default(0)
  effectiveFrom          DateTime @default(now())
  createdByAdminId       String
  createdAt              DateTime @default(now())

  @@index([model, effectiveFrom])
  @@index([provider])
}

// ─── User Management & RBAC ────────────────────────────────────────────────

model User {
  id        String   @id // Clerk userId
  email     String   @unique
  role      String   @default("USER") // "SUPER_ADMIN" | "USER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}


